{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Knowledge AI",
  "version": "0.1.4",
  "identifier": "com.knowledgeai.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Knowledge AI",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Cauan Sousa",
    "shortDescription": "Knowledge AI — Enterprise RAG platform",
    "longDescription": "Multi-tenant knowledge management and AI chat platform with support for local and cloud LLMs.",
    "category": "Productivity"
  }
}
