# ─── Local model setup ───────────────────────────────────────────────────────
# Copy this file to .env.local to run the frontend locally with a local LLM.
# All other APIs (auth, governance, ingest) continue using the cloud.

# Point model requests to the locally running Model-Router-API
VITE_MODEL_BASE_URL=http://localhost:8002/model

# Leave empty to use the default cloud APIs for everything else
# VITE_API_BASE_URL=https://api.knowledge.cauansousa.com

# ─── Supabase (keep these the same as your cloud setup) ──────────────────────
VITE_SUPABASE_URL=https://rgnvrzhzarpzzwbdhfxf.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your_supabase_anon_key>
